# Public template only. Copy this file to .env; never commit real credentials.
# The application loads .env by default, not .env.local.
PORT=7777
MONGO_URI=mongodb://127.0.0.1:27017/devTinder
JWT_SECRET=replace_with_a_long_random_secret

# Razorpay is initialized at startup. Use your own test-mode credentials.
RAZORPAY_KEY_ID=replace_with_razorpay_test_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# Email is disabled unless EMAIL_ENABLED is exactly true.
EMAIL_ENABLED=false
EMAIL_FROM=verified_sender@example.com
AWS_ACCESS_KEY=replace_with_aws_access_key
AWS_SECRET_KEY=replace_with_aws_secret_key
